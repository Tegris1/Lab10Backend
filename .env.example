POSTGRES_DB=shop_lab08
POSTGRES_USER=shop_lab08
POSTGRES_PASSWORD=password

POSTGRES_PORT=5432

DATABASE_URL=postgresql://shop_lab08:password@localhost:5432/shop_lab08

# Runtime pool limits are PER PROCESS; Vercel can run multiple processes.
# Budget the total against the provider limit and keep the database near the app region.
PG_POOL_MAX=3
PG_IDLE_TIMEOUT_MS=5000
PG_CONNECT_TIMEOUT_MS=10000

# Production: use a remote runtime-role connection, normally the provider's pooled URL.
# Require certificate and hostname validation, for example:
# DATABASE_URL=postgresql://shop_runtime:REPLACE_ME@HOST/DATABASE?sslmode=verify-full
# Inject the direct DDL-role URL as DATABASE_URL only in a separate migration terminal.
# Do not put that migration credential in the Vercel application's environment.

# npm run db:seed imports the catalogue only and preserves auth data and baskets.
# Optional Lab 08 fixtures: npm run db:seed-demo (local development databases only).
# Seed the remote catalogue only during initial setup; later seeding restores stock/prices from JSON.

TEST_DATABASE_URL=postgresql://shop_lab08:password@localhost:5432/shop_lab08_test

# Better Auth: generate a private random secret of at least 32 characters.
# Keep real credentials in .env; these variables must never use NEXT_PUBLIC_.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Register an OAuth App at https://github.com/settings/applications/new
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
# If BETTER_AUTH_URL changes, update both URLs in GitHub as well.
# Production uses a separate OAuth App and secret, with:
# BETTER_AUTH_URL=https://YOUR-STABLE-DOMAIN.vercel.app
# Callback: https://YOUR-STABLE-DOMAIN.vercel.app/api/auth/callback/github
# Set the five credentials in Vercel's Production environment only. Preview is disabled.
# Requested OAuth scopes: read:user and user:email; no repository access.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
