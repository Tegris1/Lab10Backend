POSTGRES_DB=shop_lab08
POSTGRES_USER=shop_lab08
POSTGRES_PASSWORD=password

POSTGRES_PORT=5432

DATABASE_URL=postgresql://shop_lab08:password@localhost:5432/shop_lab08

# npm run db:seed imports the catalogue only and preserves auth data and baskets.
# Optional Lab 08 fixtures: npm run db:seed-demo (local development databases only).

TEST_DATABASE_URL=postgresql://shop_lab08:password@localhost:5432/shop_lab08_test

# Better Auth: generate a private random secret of at least 32 characters.
# Keep real credentials in .env; these variables must never use NEXT_PUBLIC_.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Register an OAuth App at https://github.com/settings/applications/new
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
# If BETTER_AUTH_URL changes, update both URLs in GitHub as well.
# Requested OAuth scopes: read:user and user:email; no repository access.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
